linux和windows端滚动球联调设置：
gst-launch-1.0 videotestsrc pattern=ball ! \
>     'video/x-raw,width=1280,height=720,framerate=10/1' ! \
>     nvvidconv ! \
>     'video/x-raw(memory:NVMM),format=NV12' ! \
>     nvv4l2h265enc bitrate=5000000 ! \
>     h265parse config-interval=-1 ! \
>     rtph265pay mtu=1400 ! \
>     udpsink host=192.168.100.10 port=5000 sync=false

gst-launch-1.0 -v udpsrc port=5000 caps="application/x-rtp,media=video,clock-rate=90000,encoding-name=H265,payload=96" ! rtpjitterbuffer latency=300 ! rtph265depay ! h265parse ! d3d11h265dec ! d3d11videosink sync=false